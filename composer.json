{
    "name": "larakube/cli",
    "description": "The Professional Kubernetes Orchestrator for Laravel.",
    "keywords": ["laravel", "kubernetes", "k3s", "cli", "orchestrator"],
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "LuchTech Web Development Services",
            "email": "james@luchtech.dev"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/http": "^12.17",
        "illuminate/view": "^12.17",
        "intonate/tinker-zero": "^1.2",
        "laravel-zero/framework": "^12.0.2",
        "laravel/mcp": "^0.7.0",
        "laravel/prompts": "^0.3.16",
        "spatie/laravel-data": "^4.23",
        "symfony/yaml": "^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pao": "^1.0",
        "laravel/pint": "^1.25.1",
        "mockery/mockery": "^1.6.12",
        "pestphp/pest": "^3.8.4|^4.1.2",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpacker/phpacker": "^0.6.4",
        "spatie/pest-plugin-snapshots": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": ["larakube"]
}
