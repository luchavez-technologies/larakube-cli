echo "==================================="
echo "Running Pre-Commit Checks..."
echo "==================================="

echo "👉 Running Code Formatting (Rector + Pint)..."
composer format
if [ $? -ne 0 ]; then
    echo "❌ Code formatting failed. Please check the errors above."
    exit 1
fi

echo "👉 Running PHPStan (Static Analysis)..."
composer analyse
if [ $? -ne 0 ]; then
    echo "❌ PHPStan failed. Please fix the static analysis errors."
    exit 1
fi

echo "👉 Running Pest (Unit & Feature Tests)..."
composer test
if [ $? -ne 0 ]; then
    echo "❌ Pest tests failed. Please fix the failing tests."
    exit 1
fi

echo "✅ All checks passed! Proceeding with commit."
exit 0
