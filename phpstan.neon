includes:
    - vendor/pestphp/pest-plugin-phpstan/extension.neon
    - vendor/larastan/larastan/extension.neon

parameters:
    # Parallel workers. Was pinned to 1 "to avoid Phar extraction locks in Docker
    # on macOS" — but the project now runs on the host (see CLAUDE.md), where that
    # lock doesn't apply, and single-process forced all files through one core
    # (glacial on a many-core box). Bounded at 8 so it uses cores without letting
    # every worker's peak memory add up on a smaller box.
    parallel:
        # Sized for RAM, not cores. --memory-limit is PER WORKER, so N workers
        # ask for N x the limit: at 8 (set during a machine switch, tuned on
        # core count) this 8GB box asked for 16GB at 2G each, swapped, and hit
        # the worker timeout before the result cache was ever written — making
        # every following run cold too. OrbStack alone holds ~2.7GB here.
        maximumNumberOfProcesses: 2
        # A cold run (no/stale result cache) exceeds the 600s default per worker
        # on this codebase, and the run dies before the cache is ever written —
        # so every subsequent run is cold too. Raised so the cache can warm once.
        processTimeout: 1800.0

    # Persist the result cache in-project (gitignored) instead of the system temp
    # dir, which some setups (WSL, CI) wipe between sessions. The cache is what
    # makes PHPStan fast: a COLD run analyses all ~650 files (minutes), every run
    # after only re-checks what changed (~3s). Losing the cache = a needless cold
    # run every time. Never `phpstan clear-result-cache` as part of normal work.
    tmpDir: .phpstan

    # Level 0 = the high-impact, fast, deterministic checks. The bug that crashed
    # init was an undefined CLASS (App\Traits\IngressController); undefined
    # functions (text()) are the same family — both still fail the gate below.
    level: 0
    paths:
        - app

    # Suppress KNOWN false-positive / best-practice CATEGORIES by identifier
    # (not a per-line baseline — so editing files never churns it):
    ignoreErrors:
        # Trait helper methods (e.g. $this->line()/info()) analyzed in the wrong
        # class context — the traits are always composed onto a Command at
        # runtime. Task #78 will replace this with targeted @mixin annotations to
        # restore method-level detection.
        - identifier: method.notFound
        # env() outside config — a Laravel best-practice nag, fine for this CLI.
        - identifier: larastan.noEnvCallsOutsideOfConfig
        # Command options added dynamically at runtime; PHPStan can't see them.
        - identifier: larastan.console.undefinedOption

    # NOTE: class.notFound and function.notFound are intentionally NOT ignored —
    # those are the undefined-symbol bugs we must catch. New code is checked
    # fresh; there is no baseline to maintain.
